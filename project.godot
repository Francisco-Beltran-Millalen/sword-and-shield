[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemy"
2d_physics/layer_4="player_hitbox"
2d_physics/layer_5="player_hurtbox"
2d_physics/layer_6="enemy_hitbox"
2d_physics/layer_7="enemy_hurtbox"
2d_physics/layer_8="guard"
2d_physics/layer_9="one_way"
2d_physics/layer_10="hazard"
2d_physics/layer_11="interactable"
2d_physics/layer_12="room_trigger"

[physics]

2d/default_gravity=1400.0

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/canvas_textures/default_texture_filter=0
