; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Sword and Shield"
config/description="Plataformero metroidvania de 2 jugadores con kits asimétricos."
run/main_scene="res://systems/network/lobby.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

GameEvents="*res://autoloads/game_events.gd"
NetworkManager="*res://autoloads/network_manager.gd"
SessionState="*res://autoloads/session_state.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
; `keep` y no `expand`. Medido con un `SubViewport`: con `expand`, en cuanto la
; ventana pasa de ~17:9 la vista supera los 1280 px de la sala, los `limit_*` de
; la cámara dejan de poder cumplirse y esta se CLAVA en el centro —deja de seguir
; en X— enseñando 160 px de las salas vecinas por lado en 21:9 y 435 en 3440x1440.
; En un metroidvania eso regala el descubrimiento a quien tenga el monitor más
; ancho. `keep` fija la proporción y todos ven exactamente lo mismo, al precio de
; barras: lo resuelve el motor, sin tocar el zoom ni la cámara (§13).
window/stretch/aspect="keep"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[input]

; Un solo juego de acciones: cada cliente controla un personaje.
; Remapeables desde el panel de entrada del editor.

