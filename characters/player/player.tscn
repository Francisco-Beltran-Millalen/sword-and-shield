; Presentación. Se voltea entera con el facing (`Player._apply_facing_visuals`),
; así que TODO lo que deba mirar al lado correcto cuelga de aquí.
;
; El cuerpo es un muñeco articulado, no un rectángulo: un `Skeleton2D` con
; `Bone2D` encadenados y una primitiva colgando de cada hueso. Las primitivas no
; llevan `skeleton` ni pesos a propósito — con círculos y cuadrados el skinning
; sólo los deformaría; aquí cada pieza es rígida y la mueve su hueso, que es la
; animación cut-out que documenta Godot. El día que haya arte con deformación,
; los huesos ya están puestos y sólo hay que pintar pesos.
;
; CADERA Y TORSO SON HUESOS DISTINTOS aunque compartan origen, y esa es la pieza
; que hace que el andar no se vea tieso: la cadera bascula y se desplaza con el
; apoyo, el torso CONTRA-rota sobre ella, y lo que se lee es transferencia de
; peso y balanceo de hombros. Con un solo hueso de tronco, todo el muñeco gira
; en bloque y no hay nada que transferir.
;
; Cada miembro tiene DOS segmentos con su articulación: sin codo y sin rodilla
; una pierna que avanza es un palo rígido, y el ciclo de andar no se lee. El
; círculo del codo y el de la rodilla no son decoración — tapan el hueco que
; abre la junta al doblarse.
;
; PROPORCIÓN 1:1 — la cabeza mide lo mismo que el resto del cuerpo:
;   y=-44 .. -22  cabeza  (círculo r=11 centrado en -33)
;   y=-22 ..   0  cuerpo  (torso -22..-11; muslo -11..-5.5; pantorrilla -5.5..0)
; Los 44 px de alto son los de antes: la `CollisionShape2D` no se toca.
[node name="Visuals" type="Node2D" parent="."]

; Cuerpo compartido: la escena `body_rig.tscn`. El nombre se mantiene
; "Skeleton" para que las pistas de las animaciones (`Skeleton/Hip:...`)
; sigan resolviendo igual que cuando el esqueleto estaba inline.
[node name="Skeleton" parent="Visuals" instance=ExtResource("13")]
[node name="BodyAnimationPlayer" type="AnimationPlayer" parent="Visuals"]
libraries = {
"": ExtResource("11")
}

; `callback_mode_process = 0` es PHYSICS, no el IDLE por defecto. Dos razones:
; el estado que elige la pose se decide en `_physics_process`, así que animar en
; el bucle de dibujo metía un frame de desfase; y en `--headless` el bucle de
; dibujo avanza con un delta minúsculo, así que un test que conduzca al jugador
; vería las poses cambiar y los huesos casi quietos — verde sin funcionar.
[node name="AnimationTree" type="AnimationTree" parent="Visuals"]
tree_root = ExtResource("12")
anim_player = NodePath("../BodyAnimationPlayer")
callback_mode_process = 0
active = true

; El cuerpo se anima en DOS capas: piernas (locomoción) y torso (kit). Cada una
; cuelga de su `StateAnimationTree` con su `playback_parameter`. La capa de
; piernas ignora `KIT_ACTION` y decide andar por velocidad; la de torso escucha
; `pose_changed` (el kit anuncia ataque/guardia) y cae a `neutral` el resto.
[node name="LegsAnimator" type="Node" parent="."]
script = ExtResource("10")
animations = {
0: &"idle",
1: &"walk",
2: &"jump",
3: &"fall",
6: &"downed"
}
pose_signal = &""
playback_parameter = &"parameters/Piernas/playback"
walk_scale_parameter = &"parameters/Piernas/walk/Escala/scale"
walk_by_velocity_states = Array[int]([4])
blend_parameter = &"parameters/Mezcla/blend_amount"

[node name="TorsoAnimator" type="Node" parent="."]
script = ExtResource("10")
animations = {
5: &"hurt",
6: &"downed"
}
playback_parameter = &"parameters/Torso/playback"
default_pose = &"neutral"
walk_reference_speed = 0.0

[node name="PlayerCamera" type="Camera2D" parent="."]
enabled = false
zoom = Vector2(1.6, 1.6)
script = ExtResource("8")

[node name="MultiplayerSynchronizer" type="MultiplayerSynchronizer" parent="."]
