; Cuelga de `Visuals` y no del `Player` para que su `root_node` por defecto
; (`..`) sea justo el nodo que contiene al esqueleto: así las pistas se escriben
; `Skeleton/Torso:rotation` y la biblioteca sirve a cualquier entidad que monte
; el mismo esqueleto bajo sus visuales.
;
; El nombre NO es "AnimationPlayer": el `Attacker` del kit busca el suyo con
; `ComponentLookup`, que cae a "el primero de ese tipo a cualquier profundidad"
; si no encuentra un hijo con ese nombre. Hoy busca desde el Kit y no llegaría
; aquí, pero un componente que buscara desde el Player sí, y se llevaría este.
[node name="BodyAnimationPlayer" type="AnimationPlayer" parent="Visuals"]
libraries = {
"": ExtResource("11")
}

; `callback_mode_process = 0` es PHYSICS, no el IDLE por defecto. Dos razones:
; el estado que elige la pose se decide en `_physics_process`, así que animar en
; el bucle de dibujo metía un frame de desfase; y en `--headless` el bucle de
; dibujo avanza con un delta minúsculo, así que un test que conduzca al jugador
; vería las poses cambiar y los huesos casi quietos — verde sin funcionar.
[node name="AnimationTree" type="AnimationTree" parent="Visuals"]
tree_root = ExtResource("12")
anim_player = NodePath("../BodyAnimationPlayer")
callback_mode_process = 0
active = true

; Traduce estado → pose. Las claves son `Player.State`; la 4 (KIT_ACTION) está
; aquí como respaldo, porque la pose real de una acción de kit —atacar o
; guardar— la anuncia el propio kit por `Player.pose_changed`.
[node name="StateAnimationTree" type="Node" parent="."]
script = ExtResource("10")
animations = {
0: &"idle",
1: &"walk",
2: &"jump",
3: &"fall",
4: &"attack",
5: &"hurt",
6: &"downed"
}

[node name="PlayerCamera" type="Camera2D" parent="."]
enabled = false
zoom = Vector2(1.6, 1.6)
script = ExtResource("8")

[node name="MultiplayerSynchronizer" type="MultiplayerSynchronizer" parent="."]
replication_config = SubResource("ReplicationConfig")
