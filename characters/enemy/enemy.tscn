[node name="Attacker" type="Node" parent="."]
script = ExtResource("11")

; Hace que el gesto de golpe se vea también en el peer que NO simula: el estado
; viaja por `replicated_state` y su llegada dispara `state_changed`. La ventana
; de daño no se abre ahí — `Attacker.open_window()` ignora a quien no empezó el
; golpe— así que el remoto ve el gesto y no duplica el daño.
[node name="StateAnimator" type="Node" parent="."]
script = ExtResource("14")
animations = {
2: &"enemy_strike"
}

; El cuerpo se anima en dos capas, como el jugador. El mapa usa `Enemy.State`:
; IDLE=0, WALK=1, ATTACK=2, HURT=3, DOWNED=4. Atacando, las piernas deciden
; andar por velocidad (el gesto de la garra es aparte, en enemy_strike).
[node name="LegsAnimator" type="Node" parent="."]
script = ExtResource("18")
animations = {
0: &"idle",
1: &"walk",
4: &"downed"
}
pose_signal = &""
playback_parameter = &"parameters/Piernas/playback"
walk_scale_parameter = &"parameters/Piernas/walk/Escala/scale"
walk_by_velocity_states = Array[int]([2])
blend_parameter = &"parameters/Mezcla/blend_amount"

[node name="TorsoAnimator" type="Node" parent="."]
script = ExtResource("18")
animations = {
3: &"hurt",
4: &"downed"
}
pose_signal = &""
playback_parameter = &"parameters/Torso/playback"
default_pose = &"neutral"
walk_reference_speed = 0.0

[node name="MultiplayerSynchronizer" type="MultiplayerSynchronizer" parent="."]
replication_config = SubResource("ReplicationConfig")
