[node name="Visuals" type="Node2D" parent="."]

; El cuerpo es el rig compartido con el jugador. El color de rol (rojo) y la
; escala salen de `_apply_body_size` (modulate + scale sobre este nodo).
[node name="Skeleton" parent="Visuals" instance=ExtResource("15")]

; El `AnimationPlayer` del cuerpo NO se llama "AnimationPlayer": el `Attacker`
; busca el suyo con `ComponentLookup` y, de llamarse así, se llevaría este en
; vez del de combate (enemy_strike), que es hijo directo del enemigo.
[node name="BodyAnimationPlayer" type="AnimationPlayer" parent="Visuals"]
libraries = {
"": ExtResource("16")
}

[node name="AnimationTree" type="AnimationTree" parent="Visuals"]
tree_root = ExtResource("17")
anim_player = NodePath("../BodyAnimationPlayer")
callback_mode_process = 0
active = true

